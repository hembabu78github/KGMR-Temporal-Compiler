    rdfs:range tk:TemporalEntity ;
    owl:inverseOf tk:before .

tk:before a owl:AsymmetricProperty,
        owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:label "before" ;
    rdfs:domain tk:TemporalEntity ;
    rdfs:range tk:TemporalEntity ;
    owl:inverseOf tk:after .

tk:equalsTime a owl:ObjectProperty,
        owl:SymmetricProperty,
        owl:TransitiveProperty ;
    rdfs:label "equalsTime" ;
    rdfs:domain tk:TemporalEntity ;
    rdfs:range tk:TemporalEntity ;
    owl:inverseOf tk:equalsTime .

tk:hasSequenceMember a owl:ObjectProperty ;
    rdfs:label "has sequence member" ;
    rdfs:comment "C3-005 control: Ordered semantics deferred" ;
    rdfs:domain tk:ObservationSequence ;
    rdfs:range ckd:ClinicalObservation ;
    owl:inverseOf tk:isSequenceMemberOf .

tk:isSequenceMemberOf a owl:ObjectProperty ;
    rdfs:label "is sequence member of" ;
    rdfs:comment "C3-005 control: Inverse" ;
    rdfs:domain ckd:ClinicalObservation ;
    rdfs:range tk:ObservationSequence ;
    owl:inverseOf tk:hasSequenceMember .

tk:sameClinicalTime a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "sameClinicalTime" ;
    rdfs:domain ckd:ClinicalObservation ;
    rdfs:range ckd:ClinicalObservation ;
    owl:inverseOf tk:sameClinicalTime .

ckd:ConfirmedSustainedEGFRDecline a owl:Class ;
    rdfs:label "Confirmed Sustained eGFR Decline" ;
    rdfs:comment "Proposed D1 outcome: >=40% decline, second valid measurement >=90 days later, no intervening transient exception." ;
    rdfs:subClassOf tk:Trajectory .

ckd:DecisionRationale a owl:Class ;
    rdfs:label "Decision Rationale" ;
    rdfs:comment "Criterion-level explanation attached to a policy output." ;
    rdfs:subClassOf owl:Thing .

ckd:EstablishedCKDEligibilityState a owl:Class ;
    rdfs:label "Established CKD Eligibility State" ;
    rdfs:comment "R1.0 release-population eligibility state." ;
    rdfs:subClassOf ckd:ClinicalState .

ckd:PredictionModelVersion a owl:Class ;
    rdfs:label "Prediction Model Version" ;
    rdfs:comment "A versioned identifier for the specific D1 prediction model (algorithm, training-data snapshot and hyperparameters) that produced a ProgressionRiskAssessment instance." ;
    rdfs:subClassOf prov1:GovernanceEntity .

ckd:RecommendationStatement a owl:Class ;
    rdfs:label "Recommendation Statement" ;
    rdfs:comment "Graded guideline recommendation." ;
    rdfs:subClassOf ckd:GuidelineKnowledgeItem .

ckd:RecoveryEvent a owl:Class ;
    rdfs:label "Recovery Event" ;
    rdfs:comment "Observed recovery terminating or qualifying a transient deterioration." ;
    rdfs:subClassOf ckd:ClinicalEvent .

ckd:TherapyAssociatedGFRReductionEvaluation a owl:Class ;
    rdfs:label "Therapy-associated GFR Reduction Evaluation" ;
    rdfs:comment "Evaluation state triggered when GFR reduction after hemodynamically active therapy exceeds 30%." ;
    rdfs:subClassOf ckd:ClinicalState .

ckd:clinicalStateOf a owl:ObjectProperty ;
    rdfs:label "clinical state of" ;
    rdfs:comment "C3-005 control: Inverse" ;
    rdfs:domain ckd:ClinicalState ;
    rdfs:range ckd:ResearchSubject ;
    owl:inverseOf ckd:hasClinicalState .

ckd:groundedInKnowledgeItem a owl:ObjectProperty ;
    rdfs:label "grounded in knowledge item" ;
    rdfs:comment "C3-005 control: 1..* for rules/policies" ;
    rdfs:domain owl:Thing ;
    rdfs:range ckd:GuidelineKnowledgeItem ;
    owl:inverseOf ckd:groundsEntity .

ckd:hasClinicalEvent a owl:ObjectProperty ;
    rdfs:label "has clinical event" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain ckd:ResearchSubject ;
    rdfs:range ckd:ClinicalEvent ;
    owl:inverseOf ckd:clinicalEventOf .

ckd:usesCriterion a owl:ObjectProperty ;
    rdfs:label "uses criterion" ;
    rdfs:comment "C3-005 control: 1..*" ;
    rdfs:domain ckd:DecisionPolicyVersion ;
    rdfs:range ckd:ClinicalState .

kgmr:ExcludedKnowledgeItem a owl:Class ;
    rdfs:label "Excluded Knowledge Item" ;
    rdfs:comment "Out-of-scope item retained with an exclusion reason." ;
    rdfs:subClassOf kgmr:RuleEntity .

kgmr:MRTestingRiskCategory a owl:Class ;
    rdfs:label "MR Testing Risk Category" ;
    rdfs:comment "Derived three-level category used only to limit ordinal MR test-space size." ;
    rdfs:subClassOf ckd:ClinicalState .

prov1:ClinicalReviewRecord a owl:Class ;
    rdfs:label "Clinical Review Record" ;
    rdfs:comment "Independent reviewer decision, rationale and adjudication status." ;
    rdfs:subClassOf prov1:GovernanceEntity .

prov1:LicensingRecord a owl:Class ;
    rdfs:label "Licensing Record" ;
    rdfs:comment "Internal/public use and redistribution status." ;
    rdfs:subClassOf prov1:GovernanceEntity .

tk:ObservationSequence a owl:Class ;
    rdfs:label "Observation Sequence" ;
    rdfs:comment "Time-ordered sequence of comparable observations." ;
    rdfs:subClassOf tk:Trajectory .

tk:hasFollowUpObservation a owl:ObjectProperty ;
    rdfs:label "has follow-up observation" ;
    rdfs:comment "C3-005 control: 1..*" ;
    rdfs:domain tk:Trajectory ;
    rdfs:range ckd:ClinicalObservation .

ckd:CareContext a owl:Class ;
    rdfs:label "Care Context" ;
    rdfs:comment "Care setting and eligibility context associated with an observation, state or decision." ;
    rdfs:subClassOf owl:Thing .

ckd:MonitoringRecommendation a owl:Class ;
    rdfs:label "Monitoring Recommendation" ;
    rdfs:comment "D2 policy output." ;
    rdfs:subClassOf ckd:DecisionArtifact ;
    owl:disjointWith ckd:ReferralSupportDecision .

ckd:ReferralSupportDecision a owl:Class ;
    rdfs:label "Referral Support Decision" ;
    rdfs:comment "D3 advisory policy output." ;
    rdfs:subClassOf ckd:DecisionArtifact .

ckd:hasClinicalState a owl:ObjectProperty ;
    rdfs:label "has clinical state" ;
    rdfs:comment "C3-005 control: None globally" ;
    rdfs:domain ckd:ResearchSubject ;
    rdfs:range ckd:ClinicalState ;
    owl:inverseOf ckd:clinicalStateOf .

ckd:hasDecisionArtifact a owl:ObjectProperty ;
    rdfs:label "has decision artifact" ;
    rdfs:comment "C3-005 control: 0..* versioned" ;
    rdfs:domain ckd:ResearchSubject ;
    rdfs:range ckd:DecisionArtifact ;
    owl:inverseOf ckd:decisionFor .

ckd:hasRiskAssessment a owl:ObjectProperty ;
    rdfs:label "has risk assessment" ;
    rdfs:comment "C3-005 control: 0..* versioned" ;
    rdfs:domain ckd:ResearchSubject ;
    rdfs:range ckd:RiskAssessment ;
    owl:inverseOf ckd:riskAssessmentOf .

kgmr:CompilationEligibilityRecord a owl:Class ;
    rdfs:label "Compilation Eligibility Record" ;
    rdfs:comment "Evidence that source, computability, provenance, terminology, review and licensing gates were checked." ;
    rdfs:subClassOf prov1:GovernanceEntity .

kgmr:CompilationGateAssessment a owl:Class ;
    rdfs:label "Compilation Gate Assessment" ;
    rdfs:comment "Assessment of one compilation gate." ;
    rdfs:subClassOf prov1:GovernanceEntity .

kgmr:ExpectedClinicalRelation a owl:Class ;
    rdfs:label "Expected Clinical Relation" ;
    rdfs:comment "Expected equality, monotonic, ordinal, bounded or decision-level relation." ;
    rdfs:subClassOf kgmr:RuleEntity .

kgmr:RuleAntecedent a owl:Class ;
    rdfs:label "Rule Antecedent" ;
    rdfs:comment "Computable condition set required before a rule applies." ;
    rdfs:subClassOf kgmr:RuleEntity .

kgmr:RuleException a owl:Class ;
    rdfs:label "Rule Exception" ;
    rdfs:comment "Computable exception preventing or modifying rule execution." ;
    rdfs:subClassOf kgmr:RuleEntity .

prov1:ProvenanceRecord a owl:Class ;
    rdfs:label "Provenance Record" ;
    rdfs:comment "Source, locator, extraction, encoding and change record." ;
    rdfs:subClassOf prov1:GovernanceEntity .

ckd:AlbuminuriaCategoricalState a owl:Class ;
    rdfs:label "Albuminuria Categorical State" ;
    rdfs:comment "Albuminuria category state." ;
    rdfs:subClassOf ckd:ClinicalState .

kgmr:RuleApplicability a owl:Class ;
    rdfs:label "Rule Applicability" ;
    rdfs:comment "Population, care-setting and clinical-state applicability specification." ;
    rdfs:subClassOf kgmr:RuleEntity .

ckd:DecisionPolicyVersion a owl:Class ;
    rdfs:label "Decision Policy Version" ;
    rdfs:comment "Versioned policy used to produce D2 or D3 output." ;
    rdfs:subClassOf prov1:GovernanceEntity .

ckd:ProgressionRiskAssessment a owl:Class ;
    rdfs:label "Progression Risk Assessment" ;
    rdfs:comment "D1 output for the selected sustained-decline target." ;
    rdfs:subClassOf ckd:RiskAssessment ;
    owl:disjointWith ckd:MonitoringRecommendation,
        ckd:ReferralSupportDecision .

term:TerminologyMapping a owl:Class ;
    rdfs:label "Terminology Mapping" ;
    rdfs:comment "Mapping from local class/concept to a frozen terminology code/version." ;
    rdfs:subClassOf prov1:GovernanceEntity .

prov1:ReviewStatus a owl:Class ;
    rdfs:label "Review Status" ;
    rdfs:comment "Controlled C3-012 review status vocabulary." ;
    rdfs:subClassOf prov1:GovernanceEntity .

ckd:CKDEtiologyCategory a owl:Class ;
    rdfs:label "CKD Etiology Category" ;
    rdfs:comment "Broad cause/etiology qualifier when available." ;
    rdfs:subClassOf ckd:ClinicalState .

ckd:CKDState a owl:Class ;
    rdfs:label "CKD State" ;
    rdfs:comment "Established CKD state with cause, GFR category, albuminuria category and chronicity context." ;
    rdfs:subClassOf ckd:ClinicalState .

prov1:ReleaseRecord a owl:Class ;
    rdfs:label "Release Record" ;
    rdfs:comment "KG release identifier, freeze date, checksum and supersession history." ;
    rdfs:subClassOf prov1:GovernanceEntity .

prov1:SourceArtifact a owl:Class ;
    rdfs:label "Source Artifact" ;
    rdfs:comment "Frozen guideline, literature, dataset or design-control source." ;
    rdfs:subClassOf prov1:GovernanceEntity .

ckd:GFRCategoricalState a owl:Class ;
    rdfs:label "GFR Categorical State" ;
    rdfs:comment "GFR category state." ;
    rdfs:subClassOf ckd:ClinicalState .

ckd:MedicationExposureEvent a owl:Class ;
    rdfs:label "Medication Exposure Event" ;
    rdfs:comment "Start, stop or dose-change event for a medication class relevant to trajectory interpretation." ;
    rdfs:subClassOf ckd:ClinicalEvent ;
    owl:disjointWith ckd:DecisionArtifact .

kgmr:ConflictResolutionRecord a owl:Class ;
    rdfs:label "Conflict Resolution Record" ;
    rdfs:comment "Versioned record of a conflict, resolution or abstention." ;
    rdfs:subClassOf prov1:GovernanceEntity .

prov1:ProvenanceActivity a owl:Class ;
    rdfs:label "Provenance Activity" ;
    rdfs:comment "Activity that extracts, interprets, maps, derives or executes an artefact." ;
    rdfs:subClassOf owl:Thing .

ckd:ClinicalEvent a owl:Class ;
    rdfs:label "Clinical Event" ;
    rdfs:comment "Temporally bounded event that may alter interpretation of a state or trajectory." ;
    rdfs:subClassOf tk:TemporalEntity .

ckd:RiskAssessment a owl:Class ;
    rdfs:label "Risk Assessment" ;
    rdfs:comment "Versioned numeric or categorical risk estimate." ;
    rdfs:subClassOf owl:Thing .

kgmr:CompilationGateType a owl:Class ;
    rdfs:label "Compilation Gate Type" ;
    rdfs:comment "One of the eight frozen C3-012 compilation gates." ;
    rdfs:subClassOf kgmr:RuleEntity .

kgmr:ExecutableClinicalRule a owl:Class ;
    rdfs:label "Executable Clinical Rule" ;
    rdfs:comment "Source-linked proposition admitted to deterministic compilation." ;
    rdfs:subClassOf kgmr:RuleEntity ;
    owl:disjointWith kgmr:ContextOnlyKnowledgeItem,
        kgmr:ExcludedKnowledgeItem .

ckd:DecisionArtifact a owl:Class ;
    rdfs:label "Decision Artifact" ;
    rdfs:comment "Versioned output produced by a model or decision policy." ;
    rdfs:subClassOf owl:Thing .

kgmr:ExceptionType a owl:Class ;
    rdfs:label "Exception Type" ;
    rdfs:comment "Controlled C3-013 exception category." ;
    rdfs:subClassOf kgmr:RuleEntity .

kgmr:PrecedenceTier a owl:Class ;
    rdfs:label "Precedence Tier" ;
    rdfs:comment "One of the frozen P0-P8 precedence tiers." ;
    rdfs:subClassOf kgmr:RuleEntity .

tk:TemporalInterval a owl:Class ;
    rdfs:label "Temporal Interval" ;
    rdfs:comment "Start/end bounded temporal extent." ;
    rdfs:subClassOf tk:TemporalEntity .

kgmr:ConflictType a owl:Class ;
    rdfs:label "Conflict Type" ;
    rdfs:comment "Controlled C3-013 conflict category." ;
    rdfs:subClassOf kgmr:RuleEntity .

kgmr:RuleEntity a owl:Class ;
    rdfs:label "Rule Entity" ;
    rdfs:comment "Compiler-facing class used only in the executable-rule layer." ;
    rdfs:subClassOf owl:Thing .

ckd:GuidelineKnowledgeItem a owl:Class ;
    rdfs:label "Guideline Knowledge Item" ;
    rdfs:comment "Source-linked recommendation, practice point, definition, figure/table proposition or expert interpretation." ;
    rdfs:subClassOf owl:Thing .

tk:Trajectory a owl:Class ;
    rdfs:label "Trajectory" ;
    rdfs:comment "Ordered longitudinal abstraction derived from observations." ;
    rdfs:subClassOf tk:TemporalEntity .

ckd:ClinicalState a owl:Class ;
    rdfs:label "Clinical State" ;
    rdfs:comment "Clinically meaningful state asserted for a subject over a stated interval." ;
    rdfs:subClassOf owl:Thing .

prov1:GovernanceEntity a owl:Class ;
    rdfs:label "Governance Entity" ;
    rdfs:comment "Provenance, review, licensing, version and terminology-control entity." ;
    rdfs:subClassOf owl:Thing .

tk:TemporalEntity a owl:Class ;
    rdfs:label "Temporal Entity" ;
    rdfs:comment "Entity with time-point, interval, duration, ordering or persistence semantics." ;
    rdfs:subClassOf owl:Thing .

ckd:ResearchSubject a owl:Class ;
    rdfs:label "Research Subject" ;
    rdfs:comment "De-identified adult subject whose longitudinal CKD data are represented." ;
    rdfs:subClassOf owl:Thing .

ckd:ClinicalObservation a owl:Class ;
    rdfs:label "Clinical Observation" ;
    rdfs:comment "Measured or recorded clinical observation with value and temporal metadata." ;
    rdfs:subClassOf owl:Thing .

