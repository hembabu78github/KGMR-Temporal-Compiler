@prefix ckd: <https://ckd-tkg.org/ontology/r1.0/ckd/> .
@prefix kgmr: <https://ckd-tkg.org/ontology/r1.0/kgmr/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov1: <https://ckd-tkg.org/ontology/r1.0/prov/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix term: <https://ckd-tkg.org/ontology/r1.0/term/> .
@prefix tk: <https://ckd-tkg.org/ontology/r1.0/tk/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ckd-tkg.org/ontology/r1.0/> a owl:Ontology ;
    rdfs:label "CKD-TKG R1.0 Ontology" ;
    rdfs:comment "RDF/OWL implementation of the design-closed C3-004 through C3-013 baseline. External terminology and source-data mappings remain governed annotations." ;
    owl:versionInfo "R1.0" ;
    prov1:hasProvenanceRecord prov1:DesignClosure_C3_004_C3_013 ;
    prov1:hasReleaseRecord prov1:Release_R1_0_Implementation .

ckd:A1 a ckd:AlbuminuriaCategoricalState ;
    rdfs:label "A1" .

ckd:A2 a ckd:AlbuminuriaCategoricalState ;
    rdfs:label "A2" .

ckd:A3 a ckd:AlbuminuriaCategoricalState ;
    rdfs:label "A3" .

ckd:AlbuminuriaChangeTrajectory a owl:Class ;
    rdfs:label "Albuminuria Change Trajectory" ;
    rdfs:comment "Longitudinal ACR change including a doubling evaluation qualifier." ;
    rdfs:subClassOf tk:Trajectory .

ckd:AlbuminuriaObservation a owl:Class ;
    rdfs:label "Albuminuria Observation" ;
    rdfs:comment "Urinary albumin measurement used for A-category state or change assessment." ;
    rdfs:subClassOf ckd:ClinicalObservation .

ckd:CysticHereditary a ckd:CKDEtiologyCategory ;
    rdfs:label "CysticHereditary" .

ckd:DiabeticKidneyDisease a ckd:CKDEtiologyCategory ;
    rdfs:label "DiabeticKidneyDisease" .

ckd:DiureticExposureEvent a owl:Class ;
    rdfs:label "Diuretic Exposure Event" ;
    rdfs:comment "Diuretic exposure event relevant to volume-related changes." ;
    rdfs:subClassOf ckd:MedicationExposureEvent .

ckd:EarlyWarningEGFRChange a owl:Class ;
    rdfs:label "Early-warning eGFR Change" ;
    rdfs:comment "Subsequent-test eGFR decline >20% represented as an evaluation trigger." ;
    rdfs:subClassOf tk:Trajectory .

ckd:FigureDerivedProposition a owl:Class ;
    rdfs:label "Figure-derived Proposition" ;
    rdfs:comment "Controlled proposition extracted from a guideline figure/table cell." ;
    rdfs:subClassOf ckd:GuidelineKnowledgeItem .

ckd:G1 a ckd:GFRCategoricalState ;
    rdfs:label "G1" .

ckd:G2 a ckd:GFRCategoricalState ;
    rdfs:label "G2" .

ckd:G3a a ckd:GFRCategoricalState ;
    rdfs:label "G3a" .

ckd:G3b a ckd:GFRCategoricalState ;
    rdfs:label "G3b" .

ckd:G4 a ckd:GFRCategoricalState ;
    rdfs:label "G4" .

ckd:G5 a ckd:GFRCategoricalState ;
    rdfs:label "G5" .

ckd:GlomerularImmuneMediated a ckd:CKDEtiologyCategory ;
    rdfs:label "GlomerularImmuneMediated" .

ckd:KidneyFunctionObservation a owl:Class ;
    rdfs:label "Kidney Function Observation" ;
    rdfs:comment "Observation reflecting kidney filtration/function." ;
    rdfs:subClassOf ckd:ClinicalObservation .

ckd:NSAIDExposureEvent a owl:Class ;
    rdfs:label "NSAID Exposure Event" ;
    rdfs:comment "NSAID exposure event relevant to acute deterioration context." ;
    rdfs:subClassOf ckd:MedicationExposureEvent .

ckd:OtherUnknown a ckd:CKDEtiologyCategory ;
    rdfs:label "OtherUnknown" .

ckd:PracticePointStatement a owl:Class ;
    rdfs:label "Practice Point Statement" ;
    rdfs:comment "KDIGO practice point." ;
    rdfs:subClassOf ckd:GuidelineKnowledgeItem .

ckd:RAASInhibitorExposureEvent a owl:Class ;
    rdfs:label "RAAS Inhibitor Exposure Event" ;
    rdfs:comment "ACE inhibitor or ARB exposure event." ;
    rdfs:subClassOf ckd:MedicationExposureEvent .

ckd:SGLT2InhibitorExposureEvent a owl:Class ;
    rdfs:label "SGLT2 Inhibitor Exposure Event" ;
    rdfs:comment "SGLT2 inhibitor exposure event." ;
    rdfs:subClassOf ckd:MedicationExposureEvent .

ckd:StableKidneyFunctionTrajectory a owl:Class ;
    rdfs:label "Stable Kidney Function Trajectory" ;
    rdfs:comment "Trajectory satisfying a declared stability definition." ;
    rdfs:subClassOf tk:Trajectory .

ckd:Tubulointerstitial a ckd:CKDEtiologyCategory ;
    rdfs:label "Tubulointerstitial" .

ckd:VascularHypertensive a ckd:CKDEtiologyCategory ;
    rdfs:label "VascularHypertensive" .

ckd:affectsTrajectory a owl:ObjectProperty ;
    rdfs:label "affects trajectory" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain ckd:ClinicalEvent ;
    rdfs:range tk:Trajectory .

ckd:assessesTrajectory a owl:ObjectProperty ;
    rdfs:label "assesses trajectory" ;
    rdfs:comment "C3-005 control: 1..* candidate" ;
    rdfs:domain ckd:RiskAssessment ;
    rdfs:range tk:Trajectory .

ckd:associatedWithMedicationExposure a owl:ObjectProperty ;
    rdfs:label "associated with medication exposure" ;
    rdfs:comment "C3-005 control: MinCount 1" ;
    rdfs:domain ckd:TherapyAssociatedGFRReductionEvaluation ;
    rdfs:range ckd:MedicationExposureEvent .

ckd:hasAlbuminuriaCategory a owl:ObjectProperty ;
    rdfs:label "has albuminuria category" ;
    rdfs:comment "C3-005 control: Local 0..1" ;
    rdfs:domain ckd:CKDState ;
    rdfs:range ckd:AlbuminuriaCategoricalState .

ckd:hasAvailabilityState a owl:ObjectProperty ;
    rdfs:label "has availability state" ;
    rdfs:comment "C3-005 control: Local maxCount 1" ;
    rdfs:domain ckd:ClinicalObservation ;
    rdfs:range ckd:ObservationAvailabilityState .

ckd:hasCGAClinicalRiskCategory a owl:ObjectProperty ;
    rdfs:label "has CGA clinical risk category" ;
    rdfs:comment "C3-005 control: Local maxCount 1" ;
    rdfs:domain ckd:CKDState ;
    rdfs:range ckd:KDIGOCGARiskCategory .

ckd:hasDecisionRationale a owl:ObjectProperty ;
    rdfs:label "has decision rationale" ;
    rdfs:comment "C3-005 control: MinCount 1 for policy outputs" ;
    rdfs:domain ckd:DecisionArtifact ;
    rdfs:range ckd:DecisionRationale .

ckd:hasEligibilityState a owl:ObjectProperty ;
    rdfs:label "has eligibility state" ;
    rdfs:comment "C3-005 control: Local exactly 1 per executable snapshot" ;
    rdfs:domain ckd:ResearchSubject ;
    rdfs:range ckd:EstablishedCKDEligibilityState ;
    rdfs:subPropertyOf ckd:hasClinicalState .

ckd:hasEtiologyCategory a owl:ObjectProperty ;
    rdfs:label "has etiology category" ;
    rdfs:comment "C3-005 control: Local 0..1" ;
    rdfs:domain ckd:CKDState ;
    rdfs:range ckd:CKDEtiologyCategory .

ckd:hasGFRCategory a owl:ObjectProperty ;
    rdfs:label "has GFR category" ;
    rdfs:comment "C3-005 control: Local exactly 1 per state snapshot" ;
    rdfs:domain ckd:CKDState ;
    rdfs:range ckd:GFRCategoricalState .

ckd:hasKidneyFailureRiskAssessment a owl:ObjectProperty ;
    rdfs:label "has kidney-failure risk assessment" ;
    rdfs:comment "C3-005 control: 0..* versioned" ;
    rdfs:domain ckd:ResearchSubject ;
    rdfs:range ckd:KidneyFailureRiskAssessment ;
    rdfs:subPropertyOf ckd:hasRiskAssessment .

ckd:hasMeasurementMethodContext a owl:ObjectProperty ;
    rdfs:label "has measurement method context" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain ckd:ClinicalObservation ;
    rdfs:range ckd:MeasurementMethodContext .

ckd:hasMedicationExposureEvent a owl:ObjectProperty ;
    rdfs:label "has medication exposure event" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain ckd:ResearchSubject ;
    rdfs:range ckd:MedicationExposureEvent ;
    rdfs:subPropertyOf ckd:hasClinicalEvent .

ckd:hasMonitoringRecommendation a owl:ObjectProperty ;
    rdfs:label "has monitoring recommendation" ;
    rdfs:comment "C3-005 control: 0..* versioned" ;
    rdfs:domain ckd:ResearchSubject ;
    rdfs:range ckd:MonitoringRecommendation ;
    rdfs:subPropertyOf ckd:hasDecisionArtifact .

ckd:hasOperationalInterpretation a owl:ObjectProperty ;
    rdfs:label "has operational interpretation" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain ckd:GuidelineKnowledgeItem ;
    rdfs:range ckd:ExpertInterpretation .

ckd:hasPredictionTarget a owl:ObjectProperty ;
    rdfs:label "has prediction target" ;
    rdfs:comment "C3-005 control: Local exactly 1" ;
    rdfs:domain ckd:ProgressionRiskAssessment ;
    rdfs:range ckd:ConfirmedSustainedEGFRDecline .

ckd:hasProgressionRiskAssessment a owl:ObjectProperty ;
    rdfs:label "has progression-risk assessment" ;
    rdfs:comment "C3-005 control: 0..* versioned" ;
    rdfs:domain ckd:ResearchSubject ;
    rdfs:range ckd:ProgressionRiskAssessment ;
    rdfs:subPropertyOf ckd:hasRiskAssessment .

ckd:hasRecoveryEvent a owl:ObjectProperty ;
    rdfs:label "has recovery event" ;
    rdfs:comment "C3-005 control: MinCount 1 before recovered use" ;
    rdfs:domain ckd:AKILikeTransientDeterioration ;
    rdfs:range ckd:RecoveryEvent .

ckd:hasReferralSupportDecision a owl:ObjectProperty ;
    rdfs:label "has referral-support decision" ;
    rdfs:comment "C3-005 control: 0..* versioned" ;
    rdfs:domain ckd:ResearchSubject ;
    rdfs:range ckd:ReferralSupportDecision ;
    rdfs:subPropertyOf ckd:hasDecisionArtifact .

ckd:hasValidityAssessment a owl:ObjectProperty ;
    rdfs:label "has validity assessment" ;
    rdfs:comment "C3-005 control: Local exactly 1 before executable use" ;
    rdfs:domain ckd:ClinicalObservation ;
    rdfs:range ckd:ObservationValidityAssessment .

ckd:localIdentifier a owl:DatatypeProperty ;
    rdfs:label "localIdentifier" ;
    rdfs:comment "Stable local identifier." ;
    rdfs:domain owl:Thing ;
    rdfs:range xsd:string .

ckd:monitoringTimesPerYear a owl:DatatypeProperty ;
    rdfs:label "monitoringTimesPerYear" ;
    rdfs:comment "Optional local-policy cadence." ;
    rdfs:domain ckd:MonitoringRecommendation ;
    rdfs:range xsd:decimal .

ckd:numericRiskValue a owl:DatatypeProperty ;
    rdfs:label "numericRiskValue" ;
    rdfs:comment "Numeric risk estimate." ;
    rdfs:domain ckd:RiskAssessment ;
    rdfs:range xsd:decimal .

ckd:observationUnitCode a owl:DatatypeProperty ;
    rdfs:label "observationUnitCode" ;
    rdfs:comment "UCUM unit code." ;
    rdfs:domain ckd:ClinicalObservation ;
    rdfs:range xsd:string .

ckd:observationValue a owl:DatatypeProperty ;
    rdfs:label "observationValue" ;
    rdfs:comment "Clinical value." ;
    rdfs:domain ckd:ClinicalObservation ;
    rdfs:range xsd:decimal .

ckd:overlapsEvent a owl:ObjectProperty,
        owl:SymmetricProperty ;
    rdfs:label "overlaps event" ;
    rdfs:domain ckd:ClinicalEvent ;
    rdfs:range ckd:ClinicalEvent .

ckd:qualifiesTrajectory a owl:ObjectProperty ;
    rdfs:label "qualifies trajectory" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain ckd:ClinicalState ;
    rdfs:range tk:Trajectory .

ckd:rationaleGroundedIn a owl:ObjectProperty ;
    rdfs:label "rationale grounded in" ;
    rdfs:comment "C3-005 control: 1..*" ;
    rdfs:domain ckd:DecisionRationale ;
    rdfs:range ckd:GuidelineKnowledgeItem .

ckd:riskHorizonYears a owl:DatatypeProperty ;
    rdfs:label "riskHorizonYears" ;
    rdfs:comment "Prediction horizon." ;
    rdfs:domain ckd:RiskAssessment ;
    rdfs:range xsd:decimal .

ckd:supportedByRiskAssessment a owl:ObjectProperty ;
    rdfs:label "supported by risk assessment" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain ckd:DecisionArtifact ;
    rdfs:range ckd:RiskAssessment .

ckd:triggersTherapyEvaluation a owl:ObjectProperty ;
    rdfs:label "triggers therapy evaluation" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain ckd:MedicationExposureEvent ;
    rdfs:range ckd:TherapyAssociatedGFRReductionEvaluation .

ckd:usesReferralCGACondition a owl:ObjectProperty ;
    rdfs:label "uses referral CGA condition" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain ckd:DecisionPolicyVersion ;
    rdfs:range ckd:ReferralCGACondition ;
    rdfs:subPropertyOf ckd:usesCriterion .

ckd:usesReferralRiskCriterion a owl:ObjectProperty ;
    rdfs:label "uses referral-risk criterion" ;
    rdfs:comment "C3-005 control: 0..1 candidate" ;
    rdfs:domain ckd:DecisionPolicyVersion ;
    rdfs:range ckd:ReferralRiskCriterion ;
    rdfs:subPropertyOf ckd:usesCriterion .

kgmr:Conflict_ApplicabilityConflict a kgmr:ConflictType ;
    rdfs:label "ApplicabilityConflict" ;
    rdfs:comment "Two rules claim incompatible applicability for same snapshot." .

kgmr:Conflict_DataConflict a kgmr:ConflictType ;
    rdfs:label "DataConflict" ;
    rdfs:comment "Concurrent source records disagree after selection/status rules." .

kgmr:Conflict_DecisionPolicyConflict a kgmr:ConflictType ;
    rdfs:label "DecisionPolicyConflict" ;
    rdfs:comment "D2/D3 policy versions produce contradictory recommendations." .

kgmr:Conflict_ExceptionConflict a kgmr:ConflictType ;
    rdfs:label "ExceptionConflict" ;
    rdfs:comment "Rule exception and rule antecedent both satisfied with unclear override." .

kgmr:Conflict_ExpectedRelationConflict a kgmr:ConflictType ;
    rdfs:label "ExpectedRelationConflict" ;
    rdfs:comment "Same target/output, overlapping applicability, incompatible expected relations." .

kgmr:Conflict_ReviewConflict a kgmr:ConflictType ;
    rdfs:label "ReviewConflict" ;
    rdfs:comment "Independent reviewers disagree on clinical meaning/safety." .

kgmr:Conflict_SourceInterpretationConflict a kgmr:ConflictType ;
    rdfs:label "SourceInterpretationConflict" ;
    rdfs:comment "Source statement and author interpretation disagree or two interpretations differ." .

kgmr:Conflict_TemporalConflict a kgmr:ConflictType ;
    rdfs:label "TemporalConflict" ;
    rdfs:comment "Temporal relations cannot be simultaneously satisfied or precision makes relation uncertain." .

kgmr:Conflict_TerminologyConflict a kgmr:ConflictType ;
    rdfs:label "TerminologyConflict" ;
    rdfs:comment "Multiple candidate codes/mapping relations for same source value." .

kgmr:Conflict_VersionConflict a kgmr:ConflictType ;
    rdfs:label "VersionConflict" ;
    rdfs:comment "Different active versions of same source/rule/mapping appear applicable." .

kgmr:Exception_ApplicabilityExclusion a kgmr:ExceptionType ;
    rdfs:label "ApplicabilityExclusion" ;
    rdfs:comment "Subject/context is outside rule applicability." .

kgmr:Exception_ClinicalEventException a kgmr:ExceptionType ;
    rdfs:label "ClinicalEventException" ;
    rdfs:comment "Transient/recovery event qualifies chronic interpretation." .

kgmr:Exception_ConflictException a kgmr:ExceptionType ;
    rdfs:label "ConflictException" ;
    rdfs:comment "Another applicable rule creates unresolved contradictory expectation." .

kgmr:Exception_DataQualityException a kgmr:ExceptionType ;
    rdfs:label "DataQualityException" ;
    rdfs:comment "Required observation is invalid/unsupported." .

kgmr:Exception_LicensingReleaseException a kgmr:ExceptionType ;
    rdfs:label "LicensingReleaseException" ;
    rdfs:comment "Target release cannot expose/use restricted artefact." .

kgmr:Exception_MedicationContextException a kgmr:ExceptionType ;
    rdfs:label "MedicationContextException" ;
    rdfs:comment "Medication evaluation window changes interpretation." .

kgmr:Exception_MissingDataException a kgmr:ExceptionType ;
    rdfs:label "MissingDataException" ;
    rdfs:comment "Required observation or confirmation is absent." .

kgmr:Exception_ReviewGateException a kgmr:ExceptionType ;
    rdfs:label "ReviewGateException" ;
    rdfs:comment "Required clinical/technical review is incomplete or rejected." .

kgmr:Exception_TemporalPrecisionException a kgmr:ExceptionType ;
    rdfs:label "TemporalPrecisionException" ;
    rdfs:comment "Available time precision cannot prove temporal relation." .

kgmr:Exception_TerminologyMappingException a kgmr:ExceptionType ;
    rdfs:label "TerminologyMappingException" ;
    rdfs:comment "External mapping is unavailable/ambiguous." .

kgmr:Gate_Computable a kgmr:CompilationGateType ;
    rdfs:label "Computable" ;
    rdfs:comment "Can the proposition be deterministically represented?" .

kgmr:Gate_Conflict_resolved a kgmr:CompilationGateType ;
    rdfs:label "Conflict resolved" ;
    rdfs:comment "Are relevant conflicts/precedence decisions resolved?" .

kgmr:Gate_Licensing_allowed a kgmr:CompilationGateType ;
    rdfs:label "Licensing allowed" ;
    rdfs:comment "Can the required artefact be used in the target release?" .

kgmr:Gate_Release_integrity a kgmr:CompilationGateType ;
    rdfs:label "Release integrity" ;
    rdfs:comment "Are version, checksum and supersession metadata complete?" .

kgmr:Gate_Review_sufficient a kgmr:CompilationGateType ;
    rdfs:label "Review sufficient" ;
    rdfs:comment "Has the required review tier been reached?" .

kgmr:Gate_Scope_matched a kgmr:CompilationGateType ;
    rdfs:label "Scope matched" ;
    rdfs:comment "Is the knowledge item within C3-002 decision/population scope?" .

kgmr:Gate_Source_located a kgmr:CompilationGateType ;
    rdfs:label "Source located" ;
    rdfs:comment "Is a stable source and precise locator present?" .

kgmr:Gate_Terminology_ready a kgmr:CompilationGateType ;
    rdfs:label "Terminology ready" ;
    rdfs:comment "Are required local/external mappings versioned?" .

kgmr:P0 a kgmr:PrecedenceTier ;
    rdfs:label "P0 Input integrity / legality" ;
    rdfs:comment "Invalid/entered-in-error data and release-prohibited artefacts cannot support execution." .

kgmr:P1 a kgmr:PrecedenceTier ;
    rdfs:label "P1 Applicability gate" ;
    rdfs:comment "Out-of-scope subject/context makes the rule non-applicable." .

kgmr:P2 a kgmr:PrecedenceTier ;
    rdfs:label "P2 Explicit linked exception" ;
    rdfs:comment "An exception suppresses/qualifies only the rule and scope it explicitly references." .

kgmr:P3 a kgmr:PrecedenceTier ;
    rdfs:label "P3 Temporal/event qualifier" ;
    rdfs:comment "Closed C3-008/C3-009 event and precision semantics determine whether a condition is TRUE/FALSE/INDETERMINATE." .

kgmr:P4 a kgmr:PrecedenceTier ;
    rdfs:label "P4 Specificity" ;
    rdfs:comment "A more-specific rule may outrank a generic rule only when scope containment is explicit and the expected relations are compatible with the approved policy." .

kgmr:P5 a kgmr:PrecedenceTier ;
    rdfs:label "P5 Release/version" ;
    rdfs:comment "Within one rule/mapping lineage, the release-pinned non-superseded version is current." .

kgmr:P6 a kgmr:PrecedenceTier ;
    rdfs:label "P6 Guideline strength" ;
    rdfs:comment "Recorded as provenance metadata." .

kgmr:P7 a kgmr:PrecedenceTier ;
    rdfs:label "P7 Human adjudication" ;
    rdfs:comment "Used for unresolved same-tier or clinically meaningful conflicts." .

kgmr:P8 a kgmr:PrecedenceTier ;
    rdfs:label "P8 Unresolved" ;
    rdfs:comment "Return ABSTAIN/INDETERMINATE and block eligible compilation where required." .

kgmr:admittedFromKnowledgeItem a owl:ObjectProperty ;
    rdfs:label "admitted from knowledge item" ;
    rdfs:comment "C3-005 control: 1..*" ;
    rdfs:domain kgmr:ExecutableClinicalRule ;
    rdfs:range ckd:GuidelineKnowledgeItem ;
    rdfs:subPropertyOf ckd:groundedInKnowledgeItem .

kgmr:appliesToCareContext a owl:ObjectProperty ;
    rdfs:label "applies to care context" ;
    rdfs:comment "C3-005 control: MinCount 1" ;
    rdfs:domain kgmr:RuleApplicability ;
    rdfs:range ckd:CareContext .

kgmr:appliesToEligibilityState a owl:ObjectProperty ;
    rdfs:label "applies to eligibility state" ;
    rdfs:comment "C3-005 control: Exactly 1" ;
    rdfs:domain kgmr:RuleApplicability ;
    rdfs:range ckd:EstablishedCKDEligibilityState .

kgmr:appliesToGFRCategory a owl:ObjectProperty ;
    rdfs:label "applies to GFR category" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain kgmr:RuleApplicability ;
    rdfs:range ckd:GFRCategoricalState .

kgmr:assessesGateType a owl:ObjectProperty ;
    rdfs:label "assesses gate type" ;
    rdfs:domain kgmr:CompilationGateAssessment ;
    rdfs:range kgmr:CompilationGateType .

kgmr:conflictStatus a owl:DatatypeProperty ;
    rdfs:label "conflictStatus" ;
    rdfs:domain kgmr:ConflictResolutionRecord ;
    rdfs:range xsd:string .

kgmr:eligibilityStatus a owl:DatatypeProperty ;
    rdfs:label "eligibilityStatus" ;
    rdfs:comment "Eligible/Ineligible/Pending." ;
    rdfs:domain kgmr:CompilationEligibilityRecord ;
    rdfs:range xsd:string .

kgmr:exceptedByClinicalEvent a owl:ObjectProperty ;
    rdfs:label "excepted by clinical event" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain kgmr:RuleException ;
    rdfs:range ckd:ClinicalEvent .

kgmr:exceptedByMedicationExposure a owl:ObjectProperty ;
    rdfs:label "excepted by medication exposure" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain kgmr:RuleException ;
    rdfs:range ckd:MedicationExposureEvent .

kgmr:expectedRelationOnDecisionArtifact a owl:ObjectProperty ;
    rdfs:label "expected relation on decision artifact" ;
    rdfs:comment "C3-005 control: 0..* test-instance link" ;
    rdfs:domain kgmr:ExpectedClinicalRelation ;
    rdfs:range ckd:DecisionArtifact .

kgmr:expectedRelationOnRiskAssessment a owl:ObjectProperty ;
    rdfs:label "expected relation on risk assessment" ;
    rdfs:comment "C3-005 control: 0..* test-instance link" ;
    rdfs:domain kgmr:ExpectedClinicalRelation ;
    rdfs:range ckd:RiskAssessment .

kgmr:gateStatus a owl:DatatypeProperty ;
    rdfs:label "gateStatus" ;
    rdfs:domain kgmr:CompilationGateAssessment ;
    rdfs:range xsd:string .

kgmr:hasAntecedent a owl:ObjectProperty ;
    rdfs:label "has antecedent" ;
    rdfs:comment "C3-005 control: MinCount 1" ;
    rdfs:domain kgmr:ExecutableClinicalRule ;
    rdfs:range kgmr:RuleAntecedent .

kgmr:hasApplicability a owl:ObjectProperty ;
    rdfs:label "has applicability" ;
    rdfs:comment "C3-005 control: Exactly 1" ;
    rdfs:domain kgmr:ExecutableClinicalRule ;
    rdfs:range kgmr:RuleApplicability .

kgmr:hasConflictResolutionRecord a owl:ObjectProperty ;
    rdfs:label "has conflict resolution record" ;
    rdfs:domain kgmr:ExecutableClinicalRule ;
    rdfs:range kgmr:ConflictResolutionRecord .

kgmr:hasConflictType a owl:ObjectProperty ;
    rdfs:label "has conflict type" ;
    rdfs:domain kgmr:ConflictResolutionRecord ;
    rdfs:range kgmr:ConflictType .

kgmr:hasEligibilityRecord a owl:ObjectProperty ;
    rdfs:label "has eligibility record" ;
    rdfs:comment "C3-005 control: Exactly 1" ;
    rdfs:domain kgmr:ExecutableClinicalRule ;
    rdfs:range kgmr:CompilationEligibilityRecord .

kgmr:hasException a owl:ObjectProperty ;
    rdfs:label "has exception" ;
    rdfs:comment "C3-005 control: 0..*" ;
    rdfs:domain kgmr:ExecutableClinicalRule ;
    rdfs:range kgmr:RuleException .

kgmr:hasExpectedRelation a owl:ObjectProperty ;
    rdfs:label "has expected relation" ;
    rdfs:comment "C3-005 control: Exactly 1" ;
    rdfs:domain kgmr:ExecutableClinicalRule ;
    rdfs:range kgmr:ExpectedClinicalRelation .

kgmr:hasGateAssessment a owl:ObjectProperty ;
    rdfs:label "has gate assessment" ;
    rdfs:domain kgmr:CompilationEligibilityRecord ;
    rdfs:range kgmr:CompilationGateAssessment .

kgmr:hasMRTestingRiskCategory a owl:ObjectProperty ;
    rdfs:label "has MR-testing risk category" ;
    rdfs:comment "C3-005 control: Local maxCount 1" ;
    rdfs:domain ckd:CKDState ;
    rdfs:range kgmr:MRTestingRiskCategory .

kgmr:inclusionStatus a owl:DatatypeProperty ;
    rdfs:label "inclusionStatus" ;
    rdfs:comment "Included/ContextOnly/Excluded/Deferred." ;
    rdfs:domain ckd:GuidelineKnowledgeItem ;
    rdfs:range xsd:string .

kgmr:involvesRule a owl:ObjectProperty ;
    rdfs:label "involves rule" ;
    rdfs:domain kgmr:ConflictResolutionRecord ;
    rdfs:range kgmr:ExecutableClinicalRule .

kgmr:requiresClinicalState a owl:ObjectProperty ;
    rdfs:label "requires clinical state" ;
    rdfs:comment "C3-005 control: 0..* test-instance link" ;
