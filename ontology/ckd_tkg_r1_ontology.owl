    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/A1">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/AlbuminuriaCategoricalState"/>
    <rdfs:label>A1</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Conflict_ExpectedRelationConflict">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ConflictType"/>
    <rdfs:label>ExpectedRelationConflict</rdfs:label>
    <rdfs:comment>Same target/output, overlapping applicability, incompatible expected relations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/sourcePublicationDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>sourcePublicationDate</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/SourceArtifact"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/P6">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/PrecedenceTier"/>
    <rdfs:label>P6 Guideline strength</rdfs:label>
    <rdfs:comment>Recorded as provenance metadata.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/hasAlbuminuriaCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has albuminuria category</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/CKDState"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/AlbuminuriaCategoricalState"/>
    <rdfs:comment>C3-005 control: Local 0..1</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Exception_MedicationContextException">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ExceptionType"/>
    <rdfs:label>MedicationContextException</rdfs:label>
    <rdfs:comment>Medication evaluation window changes interpretation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/ConflictType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Conflict Type</rdfs:label>
    <rdfs:comment>Controlled C3-013 conflict category.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/RuleEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/hasEligibilityRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has eligibility record</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ExecutableClinicalRule"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/CompilationEligibilityRecord"/>
    <rdfs:comment>C3-005 control: Exactly 1</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/tk/TemporalInterval">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Temporal Interval</rdfs:label>
    <rdfs:comment>Start/end bounded temporal extent.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/tk/TemporalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/hasMeasurementMethodContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has measurement method context</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalObservation"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/MeasurementMethodContext"/>
    <rdfs:comment>C3-005 control: 0..*</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/AlbuminuriaObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Albuminuria Observation</rdfs:label>
    <rdfs:comment>Urinary albumin measurement used for A-category state or change assessment.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalObservation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/reviewStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>reviewStatus</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/ClinicalReviewRecord"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Controlled review status.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/hasCareContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has care context</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ResearchSubject"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/CareContext"/>
    <owl:inverseOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/careContextOf"/>
    <rdfs:comment>C3-005 control: None globally</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/AlbuminuriaChangeTrajectory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Albuminuria Change Trajectory</rdfs:label>
    <rdfs:comment>Longitudinal ACR change including a doubling evaluation qualifier.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/tk/Trajectory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Gate_Conflict_resolved">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/CompilationGateType"/>
    <rdfs:label>Conflict resolved</rdfs:label>
    <rdfs:comment>Are relevant conflicts/precedence decisions resolved?</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/ExpectedClinicalRelation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Expected Clinical Relation</rdfs:label>
    <rdfs:comment>Expected equality, monotonic, ordinal, bounded or decision-level relation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/RuleEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/AlbuminuriaCategoricalState">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Albuminuria Categorical State</rdfs:label>
    <rdfs:comment>Albuminuria category state.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/ReviewStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Review Status</rdfs:label>
    <rdfs:comment>Controlled C3-012 review status vocabulary.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/GovernanceEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/TherapyAssociatedGFRReductionEvaluation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Therapy-associated GFR Reduction Evaluation</rdfs:label>
    <rdfs:comment>Evaluation state triggered when GFR reduction after hemodynamically active therapy exceeds 30%.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/ReviewStatus_AuthorApproved">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/ReviewStatus"/>
    <rdfs:label>AuthorApproved</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/gateStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>gateStatus</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/CompilationGateAssessment"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/localIdentifier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>localIdentifier</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Stable local identifier.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/hasProvenanceRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has provenance record</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/ProvenanceRecord"/>
    <rdfs:comment>C3-005 control: MinCount 1 for executable artefacts</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/ClinicalReviewRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Clinical Review Record</rdfs:label>
    <rdfs:comment>Independent reviewer decision, rationale and adjudication status.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/GovernanceEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/RuleAntecedent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Rule Antecedent</rdfs:label>
    <rdfs:comment>Computable condition set required before a rule applies.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/RuleEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/StableKidneyFunctionTrajectory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Stable Kidney Function Trajectory</rdfs:label>
    <rdfs:comment>Trajectory satisfying a declared stability definition.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/tk/Trajectory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Gate_Release_integrity">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/CompilationGateType"/>
    <rdfs:label>Release integrity</rdfs:label>
    <rdfs:comment>Are version, checksum and supersession metadata complete?</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/hasClinicalEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has clinical event</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ResearchSubject"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalEvent"/>
    <owl:inverseOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/clinicalEventOf"/>
    <rdfs:comment>C3-005 control: 0..*</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Gate_Computable">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/CompilationGateType"/>
    <rdfs:label>Computable</rdfs:label>
    <rdfs:comment>Can the proposition be deterministically represented?</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Gate_Licensing_allowed">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/CompilationGateType"/>
    <rdfs:label>Licensing allowed</rdfs:label>
    <rdfs:comment>Can the required artefact be used in the target release?</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/term/hasTerminologyMapping">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has terminology mapping</rdfs:label>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/term/TerminologyMapping"/>
    <rdfs:comment>C3-005 control: 0..*</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Conflict_ReviewConflict">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ConflictType"/>
    <rdfs:label>ReviewConflict</rdfs:label>
    <rdfs:comment>Independent reviewers disagree on clinical meaning/safety.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/PracticePointStatement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Practice Point Statement</rdfs:label>
    <rdfs:comment>KDIGO practice point.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/GuidelineKnowledgeItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/affectsTrajectory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>affects trajectory</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalEvent"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/tk/Trajectory"/>
    <rdfs:comment>C3-005 control: 0..*</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/ReleaseRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Release Record</rdfs:label>
    <rdfs:comment>KG release identifier, freeze date, checksum and supersession history.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/GovernanceEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/ObservationValidityAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Observation Validity Assessment</rdfs:label>
    <rdfs:comment>Assessment of whether an observation is usable for a rule or trajectory.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalState"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/MappingActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Mapping Activity</rdfs:label>
    <rdfs:comment>Terminology or dataset mapping activity.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/ProvenanceActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/associatedWithMedicationExposure">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>associated with medication exposure</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/TherapyAssociatedGFRReductionEvaluation"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/MedicationExposureEvent"/>
    <rdfs:comment>C3-005 control: MinCount 1</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/clinicalStateOf">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>clinical state of</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalState"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ResearchSubject"/>
    <owl:inverseOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/hasClinicalState"/>
    <rdfs:comment>C3-005 control: Inverse</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/ProvenanceRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Provenance Record</rdfs:label>
    <rdfs:comment>Source, locator, extraction, encoding and change record.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/GovernanceEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/KidneyFunctionObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Kidney Function Observation</rdfs:label>
    <rdfs:comment>Observation reflecting kidney filtration/function.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalObservation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/hasObservation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has observation</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ResearchSubject"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalObservation"/>
    <owl:inverseOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/observationOf"/>
    <rdfs:comment>C3-005 control: 0..*</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/InterpretationActivity">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Interpretation Activity</rdfs:label>
    <rdfs:comment>Activity creating an explicit operational interpretation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/ProvenanceActivity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/G4">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/GFRCategoricalState"/>
    <rdfs:label>G4</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/ReviewStatus_Adjudicated">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/ReviewStatus"/>
    <rdfs:label>Adjudicated</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Conflict_VersionConflict">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ConflictType"/>
    <rdfs:label>VersionConflict</rdfs:label>
    <rdfs:comment>Different active versions of same source/rule/mapping appear applicable.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/P3">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/PrecedenceTier"/>
    <rdfs:label>P3 Temporal/event qualifier</rdfs:label>
    <rdfs:comment>Closed C3-008/C3-009 event and precision semantics determine whether a condition is TRUE/FALSE/INDETERMINATE.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/evidenceCertainty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>evidenceCertainty</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/RecommendationStatement"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/RAASInhibitorExposureEvent">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>RAAS Inhibitor Exposure Event</rdfs:label>
    <rdfs:comment>ACE inhibitor or ARB exposure event.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/MedicationExposureEvent"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/MeasurementMethodContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Measurement Method Context</rdfs:label>
    <rdfs:comment>Method/specimen context required to interpret or map an observation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/P0">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/PrecedenceTier"/>
    <rdfs:label>P0 Input integrity / legality</rdfs:label>
    <rdfs:comment>Invalid/entered-in-error data and release-prohibited artefacts cannot support execution.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/A2">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/AlbuminuriaCategoricalState"/>
    <rdfs:label>A2</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Conflict_DecisionPolicyConflict">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ConflictType"/>
    <rdfs:label>DecisionPolicyConflict</rdfs:label>
    <rdfs:comment>D2/D3 policy versions produce contradictory recommendations.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/hasGateAssessment">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has gate assessment</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/CompilationEligibilityRecord"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/CompilationGateAssessment"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/tk/BaselineObservationContext">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Baseline Observation Context</rdfs:label>
    <rdfs:comment>Baseline selection context used by a trajectory or outcome.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/tk/TemporalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/CompilationEligibilityRecord">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Compilation Eligibility Record</rdfs:label>
    <rdfs:comment>Evidence that source, computability, provenance, terminology, review and licensing gates were checked.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/GovernanceEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Exception_ConflictException">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ExceptionType"/>
    <rdfs:label>ConflictException</rdfs:label>
    <rdfs:comment>Another applicable rule creates unresolved contradictory expectation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/CompilationGateType">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Compilation Gate Type</rdfs:label>
    <rdfs:comment>One of the eight frozen C3-012 compilation gates.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/RuleEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>CKD-TKG R1.0 Ontology</rdfs:label>
    <rdfs:comment>RDF/OWL implementation of the design-closed C3-004 through C3-013 baseline. External terminology and source-data mappings remain governed annotations.</rdfs:comment>
    <owl:versionInfo>R1.0</owl:versionInfo>
    <prov1:hasProvenanceRecord rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/DesignClosure_C3_004_C3_013"/>
    <prov1:hasReleaseRecord rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/Release_R1_0_Implementation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/KDIGOCGARiskCategory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>KDIGO CGA Risk Category</rdfs:label>
    <rdfs:comment>Native four-level CGA risk category.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalState"/>
    <owl:disjointWith rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/MRTestingRiskCategory"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/prov/DesignClosure_C3_004_C3_013">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/prov/ProvenanceRecord"/>
    <rdfs:label>Chapter 3 design closure provenance</rdfs:label>
    <prov1:sourceLocator>C3-004 through C3-013 design-control artefacts and closure memos</prov1:sourceLocator>
    <prov1:recordedDateTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2026-08-06T23:37:00-04:00</prov1:recordedDateTime>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/G3a">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/GFRCategoricalState"/>
    <rdfs:label>G3a</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/VascularHypertensive">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/CKDEtiologyCategory"/>
    <rdfs:label>VascularHypertensive</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/hasPredictionTarget">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has prediction target</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ProgressionRiskAssessment"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ConfirmedSustainedEGFRDecline"/>
    <rdfs:comment>C3-005 control: Local exactly 1</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Exception_MissingDataException">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ExceptionType"/>
    <rdfs:label>MissingDataException</rdfs:label>
    <rdfs:comment>Required observation or confirmation is absent.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/observationUnitCode">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>observationUnitCode</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/ClinicalObservation"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>UCUM unit code.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/resolvedByPrecedenceTier">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>resolved by precedence tier</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ConflictResolutionRecord"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/PrecedenceTier"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/tk/Trajectory">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Trajectory</rdfs:label>
    <rdfs:comment>Ordered longitudinal abstraction derived from observations.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/tk/TemporalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/inclusionStatus">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label>inclusionStatus</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/GuidelineKnowledgeItem"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment>Included/ContextOnly/Excluded/Deferred.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/A3">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/AlbuminuriaCategoricalState"/>
    <rdfs:label>A3</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/P1">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/PrecedenceTier"/>
    <rdfs:label>P1 Applicability gate</rdfs:label>
    <rdfs:comment>Out-of-scope subject/context makes the rule non-applicable.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/tk/hasSamplingPattern">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label>has sampling pattern</rdfs:label>
    <rdfs:domain rdf:resource="https://ckd-tkg.org/ontology/r1.0/tk/Trajectory"/>
    <rdfs:range rdf:resource="https://ckd-tkg.org/ontology/r1.0/tk/SamplingPattern"/>
    <rdfs:comment>C3-005 control: Local maxCount 1</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/tk/UncertainTime">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Uncertain Time</rdfs:label>
    <rdfs:comment>Possible-time interval implied by partial precision.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/tk/TemporalEntity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Exception_TerminologyMappingException">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ExceptionType"/>
    <rdfs:label>TerminologyMappingException</rdfs:label>
    <rdfs:comment>External mapping is unavailable/ambiguous.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/RecommendationStatement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label>Recommendation Statement</rdfs:label>
    <rdfs:comment>Graded guideline recommendation.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/GuidelineKnowledgeItem"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/kgmr/Exception_TemporalPrecisionException">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/kgmr/ExceptionType"/>
    <rdfs:label>TemporalPrecisionException</rdfs:label>
    <rdfs:comment>Available time precision cannot prove temporal relation.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/DiabeticKidneyDisease">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/CKDEtiologyCategory"/>
    <rdfs:label>DiabeticKidneyDisease</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://ckd-tkg.org/ontology/r1.0/ckd/Tubulointerstitial">
    <rdf:type rdf:resource="https://ckd-tkg.org/ontology/r1.0/ckd/CKDEtiologyCategory"/>
    <rdfs:label>Tubulointerstitial</rdfs:label>
  </rdf:Description>
</rdf:RDF>
